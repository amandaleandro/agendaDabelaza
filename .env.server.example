# Configuração de Produção - Agendei
# Copie este arquivo para .env no servidor e preencha os valores

# ============================================
# BANCO DE DADOS
# ============================================
POSTGRES_PASSWORD=sua_senha_super_forte_aqui

# ============================================
# AUTENTICAÇÃO JWT
# ============================================
JWT_SECRET=sua_chave_secreta_jwt_aqui
JWT_EXPIRATION=24h

# ============================================
# GOOGLE LOGIN
# ============================================
# Mesmo Client ID do Google OAuth configurado no frontend
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# ============================================
# MERCADO PAGO
# ============================================
# Obtenha em: https://www.mercadopago.com.br/developers
# Use TEST para desenvolvimento, PROD para produção
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890-123456-abcdef1234567890abcdef1234567890-123456789
MERCADOPAGO_WEBHOOK_URL=https://api.seudominio.com/api/webhooks/mercadopago
MERCADOPAGO_SUCCESS_URL=https://app.seudominio.com/pagamento/sucesso
MERCADOPAGO_PENDING_URL=https://app.seudominio.com/pagamento/pendente
MERCADOPAGO_FAILURE_URL=https://app.seudominio.com/pagamento/falha

# ============================================
# FRONTEND
# ============================================
# URL da sua API backend
# Exemplos:
#   - Com domínio: https://api.seudominio.com
#   - Sem domínio: http://SEU_IP_SERVIDOR:3010
NEXT_PUBLIC_API_URL=https://api.seudominio.com

# ============================================
# WHATSAPP / BAILEYS
# ============================================
# Ative para conectar a sessao do WhatsApp Web no backend
WHATSAPP_BAILEYS_ENABLED=false
# Pasta onde a sessao autenticada sera salva
WHATSAPP_BAILEYS_AUTH_PATH=.baileys_auth
# Intervalo do worker de lembretes em milissegundos
WHATSAPP_REMINDER_INTERVAL_MS=60000
# Tempo de reserva do horario aguardando pagamento
WHATSAPP_PAYMENT_HOLD_MINUTES=15

# ============================================
# OPENAI - ATENDIMENTO IA NO WHATSAPP
# ============================================
# Opcional: se informar a chave, o atendimento usa IA para entender mensagens livres.
OPENAI_API_KEY=
# Opcional: modelo para extracao de intencao no WhatsApp
OPENAI_MODEL=gpt-4.1-mini

# ============================================
# OPCIONAL: Registry (se usar Magalu Cloud)
# ============================================
# REGISTRY_NAMESPACE=seu-namespace
# VERSION=latest

# ============================================
# OPCIONAL: Domínios (para nginx)
# ============================================
# DOMAIN_APP=app.seudominio.com
# DOMAIN_API=api.seudominio.com

# ============================================
# OPCIONAL: Email (para Let's Encrypt)
# ============================================
# LETSENCRYPT_EMAIL=seu@email.com

# ============================================
# COMO GERAR VALORES SEGUROS
# ============================================
# 
# Para POSTGRES_PASSWORD e JWT_SECRET, execute:
# openssl rand -base64 32
#
# Para MERCADOPAGO_ACCESS_TOKEN:
# 1. Acesse https://www.mercadopago.com.br/developers
# 2. Crie uma aplicação
# 3. Copie o Access Token (TEST ou PROD)
#
